# Copy to .env and adjust. Never commit the real .env.

# --- LLM inference -----------------------------------------------------------
# Local Ollama is the default; point COMPANY_GPU_URL at a dedicated GPU box if you have one.
USE_LOCAL_LLM=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
COMPANY_GPU_URL=http://localhost:11434
# Optional cloud fallback (LLM_PROVIDER=groq)
GROQ_API_KEY=

# --- Icinga 2 lab (docker-compose) ------------------------------------------
ICINGA_API_URL=https://localhost:5665/v1
ICINGA_API_USER=root
# Read the generated root API password from the container:
#   docker exec icinga-lab cat /etc/icinga2/conf.d/api-users.conf
ICINGA_API_PASSWORD=
DIRECTOR_API_URL=http://localhost/icingaweb2/director
ICINGAWEB2_ADMIN_PASSWORD=admin123

# MySQL IDO (shared by Icinga, Icinga Web 2 and Director in the lab container)
ICINGA_DB_PASSWORD=change-me-lab-db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=icinga2
DB_PASS=change-me-lab-db
DB_NAME=icinga2idomysql

# --- Logs (OpenSearch sandbox from docker-compose) --------------------------
ES_ENABLED=true
ES_HOST=localhost
ES_PORT=9200

# Fall back to bundled demo data when Icinga/MySQL are unreachable
DEMO_MODE=true

# --- Observability (optional) -----------------------------------------------
SENTRY_DSN=

# --- Notifications (optional) -----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEAMS_WEBHOOK_URL=
